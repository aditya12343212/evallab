# Copy this file to .env and fill in your key.
# Without OPENAI_API_KEY the app runs in MOCK MODE (simulated answers, no cost).
OPENAI_API_KEY=

# Model used for LLM-as-judge scoring
JUDGE_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

PORT=3001
